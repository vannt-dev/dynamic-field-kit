{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "outDir": "dist",
    // Matches what ng-packagr actually emits: the published fesm2022 bundle
    // uses ES2022 class fields (`value;` declarations, define semantics). This
    // said ES2019 for a while, which ng-packagr ignored, so the build shipped
    // ES2022 while the config claimed otherwise - that mismatch is why
    // tsconfig.spec.json had to override the target to test what really ships.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ES2022",
    // Angular 21 ships every entry point through `exports` only (no `main`/
    // `types`), which node10 resolution cannot read - `@angular/core/testing`
    // and friends stop resolving. Bundler resolution is what the Angular CLI
    // uses for the same reason.
    "moduleResolution": "Bundler",
    "experimentalDecorators": true
  },
  "include": ["src/**/*"]
}
