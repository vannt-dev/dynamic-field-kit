{
  "name": "@dynamic-field-kit/angular",
  "version": "1.13.0",
  "description": "Angular renderer for dynamic-field-kit",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/fesm2022/*.mjs"
  ],
  "main": "dist/fesm2022/dynamic-field-kit-angular.mjs",
  "module": "dist/fesm2022/dynamic-field-kit-angular.mjs",
  "types": "dist/types/dynamic-field-kit-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/dynamic-field-kit-angular.d.ts",
      "default": "./dist/fesm2022/dynamic-field-kit-angular.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "!dist/README.md",
    "!dist/LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@angular/common": ">=16 <23",
    "@angular/core": ">=16 <23",
    "@dynamic-field-kit/core": "^1.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "postbuild": "node ../../scripts/strip-sourcemaps.js dist && node ../../scripts/add-dts-extensions.js dist",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@dynamic-field-kit/core": "^1.13.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "jsdom": "^31.0.0",
    "ng-packagr": "^22.2.6",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "zone.js": "~0.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/dynamic-field-kit.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "angular",
    "angular-forms",
    "angular-form",
    "signals",
    "dynamic-forms",
    "dynamic-form",
    "form-builder",
    "form-engine",
    "form-validation",
    "schema-driven",
    "headless",
    "forms",
    "typescript",
    "zod",
    "yup",
    "valibot",
    "standard-schema",
    "dynamic-field-kit"
  ],
  "homepage": "https://vannt-dev.github.io/dynamic-field-kit/",
  "bugs": {
    "url": "https://github.com/vannt-dev/dynamic-field-kit/issues"
  }
}
