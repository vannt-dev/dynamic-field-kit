{
  "name": "@dynamic-field-kit/angular",
  "version": "1.4.0",
  "description": "Angular renderer for dynamic-field-kit",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/fesm2022/*.mjs"
  ],
  "main": "dist/fesm2022/dynamic-field-kit-angular.mjs",
  "module": "dist/fesm2022/dynamic-field-kit-angular.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@angular/common": ">=14 <22",
    "@angular/core": ">=14 <22",
    "@dynamic-field-kit/core": "^1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "postbuild": "node ../../scripts/strip-sourcemaps.js dist",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@dynamic-field-kit/core": "^1.3.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "jsdom": "^29.1.1",
    "ng-packagr": "^19.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11",
    "zone.js": "^0.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/dynamic-field-kit.git"
  },
  "keywords": [
    "dynamic-field",
    "dynamic-field-kit",
    "dynamic-field-kit/angular"
  ]
}
