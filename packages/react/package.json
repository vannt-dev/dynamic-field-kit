{
  "name": "@dynamic-field-kit/react",
  "version": "1.5.0",
  "description": "React renderer for dynamic-field-kit",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs",
    "./dist/index.d.ts",
    "./src/layout/defaultLayouts.tsx",
    "./src/layout/responsiveLayout.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@dynamic-field-kit/core": "^1.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@dynamic-field-kit/core": "^1.5.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.2.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsup",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/dynamic-field-kit.git",
    "directory": "packages/react"
  },
  "keywords": [
    "dynamic-field",
    "dynamic-field-kit",
    "dynamic-field-kit/react"
  ],
  "homepage": "https://github.com/vannt-dev/dynamic-field-kit/tree/develop/packages/react#readme",
  "bugs": {
    "url": "https://github.com/vannt-dev/dynamic-field-kit/issues"
  },
  "types": "./dist/index.d.ts"
}
