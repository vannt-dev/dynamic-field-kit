{
  "name": "@dynamic-field-kit/vue",
  "version": "1.7.0",
  "description": "Vue 3 renderer for dynamic-field-kit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/index.d.ts",
    "./src/layout/defaultLayouts.ts",
    "./src/layout/responsiveLayout.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@dynamic-field-kit/core": "^1.3.0",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@dynamic-field-kit/core": "^1.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.32"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsup",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/dynamic-field-kit.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-forms",
    "vue-form",
    "form-state",
    "dynamic-forms",
    "dynamic-form",
    "form-builder",
    "form-engine",
    "form-validation",
    "schema-driven",
    "headless",
    "forms",
    "typescript",
    "zod",
    "yup",
    "valibot",
    "standard-schema",
    "dynamic-field-kit"
  ],
  "homepage": "https://vannt-dev.github.io/dynamic-field-kit/",
  "bugs": {
    "url": "https://github.com/vannt-dev/dynamic-field-kit/issues"
  }
}
