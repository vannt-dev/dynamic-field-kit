{
  "name": "@dynamic-field-kit/vue",
  "version": "1.4.0",
  "description": "Vue 3 renderer for dynamic-field-kit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/index.d.ts",
    "./src/layout/defaultLayouts.ts",
    "./src/layout/responsiveLayout.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@dynamic-field-kit/core": "^1.3.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@dynamic-field-kit/core": "^1.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.32"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "npx tsup",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/dynamic-field-kit.git"
  },
  "keywords": [
    "dynamic-field",
    "dynamic-field-kit",
    "dynamic-field-kit/vue"
  ]
}
